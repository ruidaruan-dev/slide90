{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide90 Core Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suite", "description", "cases"],
  "properties": {
    "version": {"const": "1.0"},
    "suite": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "layout": {"enum": ["performance-dashboard", "evidence-matrix", "diagnosis-tree", "roadmap", "capability-loop", "portfolio-table", "comparison-matrix", "decision-page"]},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "prompt", "expected_layout", "expected_title_intent", "required_facts", "must_not_invent"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "category": {"$ref": "#/$defs/layout"},
        "prompt": {"type": "string", "minLength": 40},
        "expected_layout": {"$ref": "#/$defs/layout"},
        "expected_title_intent": {"type": "string", "minLength": 8, "maxLength": 120},
        "required_facts": {"type": "array", "minItems": 4, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 80}},
        "must_not_invent": {"type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 80}}
      }
    }
  }
}
