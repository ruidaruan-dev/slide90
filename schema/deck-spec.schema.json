{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slide90.dev/schema/deck-spec.schema.json",
  "title": "Slide90 Deck Specification",
  "description": "The stable factual contract between an agent planner and a deterministic presentation renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "deck_title", "audience", "slides"],
  "properties": {
    "version": {"const": "1.0"},
    "deck_title": {"type": "string", "minLength": 1, "maxLength": 120},
    "audience": {"type": "string", "minLength": 1, "maxLength": 120},
    "decision": {"type": "string", "maxLength": 240},
    "brief": {"$ref": "#/$defs/brief"},
    "language": {"type": "string", "default": "en-US", "maxLength": 16},
    "theme": {"type": "string", "default": "slide90", "maxLength": 40},
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "structure_mode"],
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 240},
        "structure_mode": {"enum": ["preserve-user-structure", "propose-lightly"]},
        "structure_confirmed": {"type": "boolean", "default": false},
        "must_keep_facts": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {"type": "string", "minLength": 1, "maxLength": 24},
        "label": {"type": "string", "minLength": 1, "maxLength": 60},
        "detail": {"type": "string", "maxLength": 80},
        "accent": {"enum": ["blue", "green", "purple", "orange", "navy"]}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 64},
        "body": {"type": "string", "maxLength": 180},
        "evidence": {"type": "string", "maxLength": 180},
        "proof": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 44}
        },
        "role": {"type": "string", "maxLength": 48},
        "owner": {"type": "string", "maxLength": 48},
        "timing": {"type": "string", "maxLength": 48},
        "status": {"type": "string", "maxLength": 32},
        "group": {"enum": ["business", "internal", "external"]},
        "accent": {"enum": ["blue", "green", "purple", "orange", "navy"]}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "layout", "blocks"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 99},
        "section": {"type": "string", "maxLength": 80},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "subtitle": {"type": "string", "maxLength": 180},
        "layout": {
          "enum": [
            "performance-dashboard",
            "evidence-matrix",
            "diagnosis-tree",
            "roadmap",
            "capability-loop",
            "portfolio-table",
            "comparison-matrix",
            "decision-page"
          ]
        },
        "metrics": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/metric"}
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/block"}
        },
        "conclusion": {"type": "string", "maxLength": 220},
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"layout": {"const": "evidence-matrix"}}, "required": ["layout"]},
          "then": {
            "required": ["conclusion"],
            "properties": {
              "blocks": {
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/block"},
                    {"required": ["body", "evidence"]}
                  ]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"layout": {"const": "performance-dashboard"}}, "required": ["layout"]},
          "then": {
            "required": ["conclusion", "metrics"],
            "properties": {
              "metrics": {"minItems": 2, "maxItems": 5},
              "blocks": {
                "minItems": 2,
                "maxItems": 4,
                "items": {"allOf": [{"$ref": "#/$defs/block"}, {"required": ["body", "evidence"]}]}
              }
            }
          }
        },
        {
          "if": {"properties": {"layout": {"const": "roadmap"}}, "required": ["layout"]},
          "then": {
            "required": ["conclusion"],
            "properties": {
              "blocks": {
                "minItems": 2,
                "maxItems": 3,
                "items": {"allOf": [{"$ref": "#/$defs/block"}, {"required": ["body", "timing"]}]}
              }
            }
          }
        },
        {
          "if": {"properties": {"layout": {"const": "portfolio-table"}}, "required": ["layout"]},
          "then": {
            "required": ["conclusion"],
            "properties": {
              "blocks": {
                "minItems": 2,
                "maxItems": 8,
                "items": {"allOf": [{"$ref": "#/$defs/block"}, {"required": ["body", "owner", "timing", "status"]}]}
              }
            }
          }
        },
        {
          "if": {"properties": {"layout": {"const": "decision-page"}}, "required": ["layout"]},
          "then": {
            "required": ["conclusion"],
            "properties": {
              "blocks": {
                "minItems": 2,
                "maxItems": 3,
                "items": {"allOf": [{"$ref": "#/$defs/block"}, {"required": ["body", "evidence"]}]}
              }
            }
          }
        },
        {
          "if": {"properties": {"layout": {"const": "capability-loop"}}, "required": ["layout"]},
          "then": {
            "required": ["conclusion"],
            "properties": {
              "blocks": {
                "minItems": 4,
                "maxItems": 6,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/block"},
                    {"required": ["body", "role", "group"]}
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
